// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  email    String  @unique // the one the account was made with; a sign-in method added later never replaces it
  name     String
  provider String? // 'apple' | 'google' — the sign-in method used most recently
  subject  String? // accounts from before SignInMethod: their first sign-in's provider 'sub'. Never written now
  settings Json? // { autoTrackChapters: Boolean, ... }

  signInMethods SignInMethod[] @relation("signInMethods")
  passageTracks PassageTrack[] @relation("passageTracks")
  chapterTracks ChapterTrack[] @relation("chapterTracks")
}

// One way into an account: a particular Apple ID, or a particular Google account. A user has
// one or more; each opens exactly one user, which the unique index enforces. Signing in finds
// the user by this first, and only then by email. See docs/adr/0004 in the iOS app's repo.
model SignInMethod {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  user   User   @relation("signInMethods", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId String @db.ObjectId

  provider String // 'apple' | 'google'
  subject  String // the provider's 'sub' for this person
  email    String? // what the provider gave when it was added — an Apple relay address, perhaps
  addedAt  String

  // Sign in with Apple's refresh token, from the authorization code the app sends, and the
  // client it was issued to. Kept only to revoke it when this method is removed or the
  // account deleted.
  appleRefreshToken String?
  appleClientId     String?

  @@unique([provider, subject])
}

model PassageTrack {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  user   User?   @relation("passageTracks", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId String? @db.ObjectId

  passageDate String // 'YYYY-MM-DD'
  passageType String // 'bible' | 'proverbs' | 'psalms' (non-null)
  isRead      Boolean
  trackDate   String // human "when read"
  updatedAt   String // client action-time; sync version (LWW)
  serverAt    String // server receive time (audit)

  // The app that made the latest change, and its version: 'ios' | 'android' | 'web', and
  // '1.1.3 (10)' or the website's package version. Null: unknown - a change from an app
  // released before the stamp, or anything synced from 2026-09-16 until it. ADR 0010 in the
  // app's repo.
  client        String?
  clientVersion String?

  @@unique([userId, passageDate, passageType])
}

model ChapterTrack {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  user   User?   @relation("chapterTracks", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId String? @db.ObjectId

  year      Int // the calendar year it was read in: a Read Chapter is one year's, as a plan is
  book      String // USFM id: GEN, PRO, PSA, ...
  chapter   String
  isRead    Boolean
  trackDate String
  updatedAt String // client action-time; sync version (LWW)
  serverAt  String

  // The app that made the latest change, and its version: 'ios' | 'android' | 'web', and
  // '1.1.3 (10)' or the website's package version. Null: unknown - a change from an app
  // released before the stamp, or anything synced from 2026-09-16 until it. ADR 0010 in the
  // app's repo.
  client        String?
  clientVersion String?

  @@unique([userId, year, book, chapter])
}

// The Operator: who can see how the app is used (CONTEXT.md in the app's repo, and its
// docs/operator-plan.md). Written by hand, never by a route - not a field on User, which
// saving an account writes. Keyed by the account, so every sign-in method of it opens it.
model Operator {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  userId  String @unique @db.ObjectId
  addedAt String
}

// Accounts left out of everything the Operator sees - test accounts, and Google Play's
// review accounts. Written by hand, with `pnpm operator:leave-out <email>`.
model OperatorLeavesOut {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  userId  String @unique @db.ObjectId
  addedAt String
}
