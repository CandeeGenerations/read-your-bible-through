{
  "name": "read-your-bible-through-server",
  "version": "1.12.0",
  "private": true,
  "description": "Read your Bible through in a year!",
  "homepage": "https://github.com/CandeeGenerations/read-your-bible-through#readme",
  "bugs": {
    "url": "https://github.com/CandeeGenerations/read-your-bible-through/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:CandeeGenerations/read-your-bible-through.git"
  },
  "license": "MIT",
  "author": "Candee Generations <admin@candeegenerations.com>",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "rm -rf dist && pnpm generate && NODE_ENV=production tsc && tsc-alias",
    "db:push": "phase run 'pnpm exec prisma db push'",
    "dev": "pnpm start",
    "eslint": "pnpm run lint",
    "fix": "pnpm run lint && pnpm run prettier --cache",
    "generate": "pnpm exec prisma format && pnpm exec prisma generate --no-hints",
    "preinstall": "sh ../scripts/check-versions.sh && npx only-allow pnpm",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "migrate:phase0": "phase run 'pnpm exec tsx scripts/migrate-phase0.ts'",
    "pcheck": "npm-check -u -i '{prisma,@prisma/client}' && pnpm audit",
    "prettier": "prettier --cache --check --write --ignore-unknown .",
    "prettier:ci": "prettier --check .",
    "start": "fnm use; phase run 'pnpm generate && NODE_ENV=development tsx watch src/index.ts'"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.23",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "oxlint": "1.83.0",
    "prettier": "3.9.7",
    "prisma": "6.19.3",
    "tsc-alias": "1.9.5",
    "tsx": "4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
